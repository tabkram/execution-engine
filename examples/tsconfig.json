{
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "ES2020",
    "module": "CommonJS",
    // Type-checking only (never emit): covers `new Error(msg, { cause })` used in src.
    "lib": ["ES2022"],
    // TypeScript >=6 defaults "strict" to true; pinned to false to keep the pre-6 behaviour.
    "strict": false,
    // TypeScript >=6 no longer pulls in every @types/* package automatically.
    "types": ["node"]
  }
}
